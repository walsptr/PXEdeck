#!/usr/bin/env bash
# infra/test/fake-bin-m8/curl — pembungkus test M8 di atas fake-bin/curl (tanpa jaringan): bila ada
# `-o <file>` dan $FAKE_STATE/curl-files/<basename URL> tersedia, file itu disalin ke <file>
# ("unduhan" palsu nodejs.org/deb.debian.org). Pencatatan + model HTTP tetap oleh fake-bin/curl.
# Kegagalan unduhan disimulasikan lewat FAKE_CURL_FAIL_URL / FAKE_CURL_FAIL_RC (lihat di bawah).
out=""; prev=""
for a in "$@"; do [[ "$prev" == -o ]] && out="$a"; prev="$a"; done
url="${*: -1}"
# FAKE_CURL_FAIL_URL=<glob>: URL yang cocok "gagal" dengan exit ${FAKE_CURL_FAIL_RC:-28} (28 = timeout),
# tanpa menyalin file (keluaran parsial dibuat agar penghapusan oleh installer bisa diasersi).
if [[ -n "${FAKE_CURL_FAIL_URL:-}" && "$url" == $FAKE_CURL_FAIL_URL ]]; then
  echo "curl $*" >> "${FAKE_LOG:?}"
  [[ -n "$out" && "$out" != /dev/null ]] && echo partial > "$out"
  exit "${FAKE_CURL_FAIL_RC:-28}"
fi
src="${FAKE_STATE:?}/curl-files/${url##*/}"
if [[ -n "$out" && "$out" != /dev/null && -f "$src" ]]; then cp "$src" "$out"; fi
exec "$(dirname "$0")/../fake-bin/curl" "$@"
