#!/usr/bin/env bash
# virt-install PALSU: catat argumen, buat domain di state palsu (running).
set -uo pipefail
echo "virt-install $*" >> "$FAKE_LOG"
name=""; nvram=0
while [[ $# -gt 0 ]]; do
  case "$1" in --name) name="$2"; shift ;; --boot) [[ "$2" == *nvram.template* ]] && nvram=1; shift ;; esac
  shift
done
mkdir -p "$FAKE_STATE/dom"; echo running > "$FAKE_STATE/dom/$name"
((nvram)) && touch "$FAKE_STATE/dom/$name.nvram"
exit 0
