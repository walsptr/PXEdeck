# /etc/pxe-dashboard.env (topologi VLAN, M7) — env dashboard di VM pxe-test-server untuk run KVM
# `kvm-run.sh m7 --scenario vlan*` (deploy-dashboard.sh --topology vlan; docs/design/M7-plan.md §2.3).
# Identik infra/server/dashboard.env kecuali blok jaringan: node boot di VLAN 10 (PXE, native) dan
# memakai IP statis di VLAN 20 (management, terdaftar di PXE_VLAN_NETWORKS). UI/API admin tetap di
# http://10.99.0.2 (segmen admin pxe-test; allowlist nginx PXE_ADMIN_ALLOW=10.99.0.1).
# Dipasang oleh infra/deploy-dashboard.sh (root:pxe 0640). Tanpa rahasia; nilai lab KVM.
# Divalidasi saat start (src/lib/server/settings.ts); env invalid → service gagal start.
NODE_ENV=production
PXE_DB_PATH=/var/lib/pxe-dashboard/pxe.db
PXE_SEED=empty

# Subnet PXE = VLAN 10 (nama variabel lama, DEC-006); gateway .1 cadangan (tidak dipakai perangkat;
# dnsmasq-vlan.conf tanpa opsi router). PXE_SERVER_IP/BASE/MEDIA = alamat VLAN PXE (nfsroot,
# inst.stage2, media Debian lokal DEC-021/022: host PXE_MEDIA_URL == PXE_SERVER_IP).
PXE_MGMT_CIDR=10.99.10.0/24
PXE_MGMT_GATEWAY=10.99.10.1
PXE_MGMT_DNS=10.99.10.2
PXE_SERVER_IP=10.99.10.2
PXE_DHCP_RANGE=10.99.10.100-10.99.10.200
PXE_DHCP_INTERFACE=pxe10
# VLAN management terdaftar (DEC-024 O4-B): "<vlan>:<cidr>:<gateway>[;…]". Gateway 10.99.20.1 = mgmt20
# di VM server (penerimaan lokal, ip_forward=0).
PXE_VLAN_NETWORKS=20:10.99.20.0/24:10.99.20.1

PXE_BASE_URL=http://10.99.10.2
PXE_MEDIA_URL=http://10.99.10.2/media
PXE_MEDIA_ROOT=/srv/pxe/media
PXE_TFTP_ROOT=/srv/pxe/tftp

# dnsmasq di VM ini (infra/server/dnsmasq.conf: dhcp-leasefile; pidfile unit Ubuntu).
PXE_DNSMASQ_LEASES=/var/lib/misc/dnsmasq.leases
PXE_DNSMASQ_PIDFILE=/run/dnsmasq/dnsmasq.pid

# Next hanya listen 127.0.0.1:3000 di belakang nginx lokal yang menyetel X-Real-IP.
PXE_TRUST_PROXY=1
# Host header: UI admin lewat 10.99.0.2, node lewat 10.99.10.2.
PXE_ALLOWED_HOSTS=10.99.0.2,10.99.10.2

PXE_TOKEN_TTL_MIN=360
# Siklus hidup job (M5, DEC-014). KVM: installing 15 mnt agar uji `virsh destroy` → Failed
# selesai dalam run (≥ 1,5× durasi install M4 terukur); watchdog 15 dtk.
PXE_JOB_BOOTING_TIMEOUT_MIN=60
PXE_JOB_INSTALLING_TIMEOUT_MIN=15
PXE_JOB_CONFIGURING_TIMEOUT_MIN=60
PXE_JOB_MAX_INSTALLER_BOOTS=3
PXE_WATCHDOG_INTERVAL_SEC=15
PXE_JOB_LOG_MAX_EVENTS=5000
PXE_JOB_HISTORY_PER_HOST=20
PXE_INSECURE_NO_LEASE_CHECK=0
PXE_UNKNOWN_HOST_ACTION=local
PXE_KERNEL_EXTRA_ARGS="console=ttyS0,115200n8 console=tty0"

# --- Login admin (M6, DEC-017 §1–§5) ---
# Username non-rahasia. Hash TIDAK disimpan di repo: placeholder di bawah diganti saat deploy
# (deploy-dashboard.sh → install-dashboard.sh, hash dari `npm run admin:hash` lewat stdin, file
# root:pxe 0640). Placeholder tersisa → service menolak start (format hash tidak valid).
PXE_ADMIN_USERNAME=pxeadmin
PXE_ADMIN_PASSWORD_HASH=@PXE_ADMIN_PASSWORD_HASH@
# Sesi lebih panjang untuk run KVM (±1–2 jam per run).
PXE_SESSION_IDLE_MIN=240
PXE_SESSION_MAX_HOURS=12
PXE_LOGIN_MAX_FAILURES=5
PXE_LOGIN_WINDOW_MIN=15
PXE_API_RATE_PER_MIN=600
