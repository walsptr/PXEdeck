# /etc/pxe-dashboard.env — env dashboard di VM pxe-test-server (lab KVM, M4-T7).
# Dipasang oleh infra/deploy-dashboard.sh (root:pxe 0640). Tanpa rahasia; nilai lab KVM.
# Divalidasi saat start (src/lib/server/settings.ts); env invalid → service gagal start.
NODE_ENV=production
PXE_DB_PATH=/var/lib/pxe-dashboard/pxe.db
PXE_SEED=empty

# Subnet management KVM (DEC-003/006); DNS boleh di luar subnet (DEC-011).
PXE_MGMT_CIDR=10.99.0.0/24
PXE_MGMT_GATEWAY=10.99.0.1
PXE_MGMT_DNS=10.99.0.2
PXE_SERVER_IP=10.99.0.2
PXE_DHCP_RANGE=10.99.0.100-10.99.0.200
PXE_DHCP_INTERFACE=pxe0

PXE_BASE_URL=http://10.99.0.2
PXE_MEDIA_URL=http://10.99.0.2/media
PXE_MEDIA_ROOT=/srv/pxe/media
PXE_TFTP_ROOT=/srv/pxe/tftp

# dnsmasq di VM ini (infra/server/dnsmasq.conf: dhcp-leasefile; pidfile unit Ubuntu).
PXE_DNSMASQ_LEASES=/var/lib/misc/dnsmasq.leases
PXE_DNSMASQ_PIDFILE=/run/dnsmasq/dnsmasq.pid

# Next hanya listen 127.0.0.1:3000 di belakang nginx lokal yang menyetel X-Real-IP.
PXE_TRUST_PROXY=1
PXE_ALLOWED_HOSTS=10.99.0.2

PXE_TOKEN_TTL_MIN=360
# Siklus hidup job (M5, DEC-014). KVM: installing 15 mnt agar uji `virsh destroy` → Failed
# selesai dalam run (≥ 1,5× durasi install M4 terukur); watchdog 15 dtk.
PXE_JOB_BOOTING_TIMEOUT_MIN=60
PXE_JOB_INSTALLING_TIMEOUT_MIN=15
PXE_JOB_CONFIGURING_TIMEOUT_MIN=60
PXE_JOB_MAX_INSTALLER_BOOTS=3
PXE_WATCHDOG_INTERVAL_SEC=15
PXE_JOB_LOG_MAX_EVENTS=5000
PXE_JOB_HISTORY_PER_HOST=20
PXE_INSECURE_NO_LEASE_CHECK=0
PXE_UNKNOWN_HOST_ACTION=local
PXE_KERNEL_EXTRA_ARGS="console=ttyS0,115200n8 console=tty0"
