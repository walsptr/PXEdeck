#cloud-config
# /srv/pxe/http/autoinstall/user-data — konfigurasi Subiquity autoinstall
# TEMPLATE: placeholder hash password & public key admin (lihat identity/ssh) diisi oleh
# scripts/setup-pxe-server.sh (render-user-data) dari env saat deploy.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: Asia/Jakarta

  network:
    version: 2
    ethernets:
      primary:
        match:
          name: "en*"
        dhcp4: true

  identity:
    hostname: ubuntu-node
    username: ubuntu
    # Hash SHA-512 crypt diisi saat deploy dari env PXE_PASSWORD_HASH (openssl passwd -6).
    # Jangan commit hash/password sungguhan ke repo.
    password: "@PXE_PASSWORD_HASH@"

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      # Public key admin diisi saat deploy dari env PXE_ADMIN_SSH_KEY.
      - "@PXE_ADMIN_SSH_KEY@"

  storage:
    layout:
      name: lvm
      sizing-policy: all

  packages:
    - curl
    - vim
    - net-tools

  updates: security

  late-commands:
    # Sudo tanpa password untuk user ubuntu
    - echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/90-ubuntu && chmod 440 /target/etc/sudoers.d/90-ubuntu
    # UEFI: taruh entry "ubuntu" di urutan boot pertama agar tidak PXE-install berulang
    - |
      if [ -d /sys/firmware/efi ]; then
        n=$(efibootmgr | awk '/[Uu]buntu/ {print substr($1,5,4); exit}')
        o=$(efibootmgr | awk -F': ' '/^BootOrder/ {print $2}')
        if [ -n "$n" ]; then
          efibootmgr -o "$(echo "$n,$o" | tr ',' '\n' | awk '!s[$0]++' | paste -sd,)" || true
        fi
      fi

    # Netboot NFS: shutdown live installer bisa macet di "Failed unmounting /cdrom"
    # (root NFS masih dipakai saat jaringan dimatikan). Guard ini hanya aktif saat
    # sistem sudah dalam status "stopping": tunggu 45 detik, sync, lalu reboot paksa.
    - >-
      systemd-run --unit=pxe-force-reboot -p DefaultDependencies=no
      /bin/sh -c 'until [ "$(systemctl is-system-running)" = stopping ]; do sleep 2; done;
      sleep 45; echo s > /proc/sysrq-trigger; sleep 3; echo b > /proc/sysrq-trigger'

  shutdown: reboot
