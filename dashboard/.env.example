# Contoh env server dashboard (nilai dummy/default lab). Salin ke .env.local.

# Subnet management (DEC-006). Kosong = default lab 10.10.10.0/24.
# Lingkungan uji KVM (DEC-003) memakai 10.99.0.0/24.
# PXE_MGMT_CIDR=10.99.0.0/24
# PXE_MGMT_GATEWAY=10.99.0.1
# PXE_MGMT_DNS=10.99.0.1
# PXE_SERVER_IP=10.99.0.2
# PXE_DYNAMIC_RANGE=10.99.0.100-10.99.0.200

# Store mock (DEC-005, hanya sampai M4).
# off/0/false = tanpa simulasi tahap, discovery, dan lease renew acak.
# PXE_MOCK_SIMULATION=off
# Interval discovery host baru (ms, default 40000).
# PXE_MOCK_DISCOVER_EVERY_MS=2000
# Seed store awal: default (14 host) | empty.
# PXE_MOCK_SEED=default
