# Contoh konfigurasi server PXE dashboard (M4-T1). Nilai DUMMY/default lab, bukan rahasia.
# Salin ke .env.local (dev) atau /etc/pxe-dashboard.env (VM server) lalu sesuaikan.
# Semua divalidasi saat start (src/lib/server/settings.ts); error menyebut nama variabel.

# --- Persistence (DEC-007) ---
PXE_DB_PATH=./data/pxe.db
# empty | demo (demo hanya bila NODE_ENV != production)
PXE_SEED=empty

# --- Subnet management (DEC-006) ---
PXE_MGMT_CIDR=10.10.10.0/24
PXE_MGMT_GATEWAY=10.10.10.1
# Satu atau lebih IPv4 (dipisah koma), boleh di luar subnet (DEC-011); bukan loopback/multicast/0.0.0.0/broadcast
PXE_MGMT_DNS=10.10.10.1
PXE_SERVER_IP=10.10.10.1
# Range DHCP dinamis dnsmasq (IP statis tidak boleh di sini). Alias lama: PXE_DYNAMIC_RANGE
PXE_DHCP_RANGE=10.10.10.100-10.10.10.200
# Nama NIC DHCP (hanya tampilan)
PXE_DHCP_INTERFACE=enp7s0

# --- URL & path media ---
PXE_BASE_URL=http://10.10.10.1
# Default: ${PXE_BASE_URL}/media
PXE_MEDIA_URL=http://10.10.10.1/media
PXE_MEDIA_ROOT=/srv/pxe/media
PXE_TFTP_ROOT=/srv/pxe/tftp

# --- dnsmasq (kosong = mode dev: verifikasi lease nonaktif, status DHCP/TFTP "unknown") ---
PXE_DNSMASQ_LEASES=
PXE_DNSMASQ_PIDFILE=

# 1 = percaya header X-Real-IP / X-Forwarded-Host (HANYA bila Next listen 127.0.0.1 di belakang
# nginx lokal). Sejak M5 (DEC-013) WAJIB disertai PXE_DNSMASQ_LEASES; tanpa itu server menolak start.
PXE_TRUST_PROXY=0
# RISIKO — HANYA untuk dev lokal tanpa dnsmasq. 1 = izinkan PXE_TRUST_PROXY=1 tanpa file lease dan
# terbitkan script installer + token tanpa verifikasi IP lease. Siapa pun di jaringan yang bisa
# mencapai dashboard dapat mengklaim IP host mana pun lalu mengambil file konfigurasi installer
# (hash password, authorized_keys). JANGAN pernah 1 di server PXE sungguhan. Diperingatkan saat start
# dan di halaman Settings. Tanpa file lease dan tanpa flag ini, /boot/{mac}.ipxe hanya boot lokal.
PXE_INSECURE_NO_LEASE_CHECK=0
# Masa berlaku token konfigurasi per job (menit, DEC-008). Wajib ≥ jumlah tiga timeout tahap di
# bawah (DEC-014).
PXE_TOKEN_TTL_MIN=360

# --- Siklus hidup job (M5, DEC-014) ---
# Timeout absolut per tahap (menit, 1–1440). Lewat → job & host Failed (timeout-<tahap>).
PXE_JOB_BOOTING_TIMEOUT_MIN=60
PXE_JOB_INSTALLING_TIMEOUT_MIN=120
PXE_JOB_CONFIGURING_TIMEOUT_MIN=60
# Maks. penyajian script installer per job (1–10); lewat → Failed (installer-boot-limit)
PXE_JOB_MAX_INSTALLER_BOOTS=3
# Interval sapuan watchdog in-process (detik, 5–600); sapuan juga dijalankan saat baca status
PXE_WATCHDOG_INTERVAL_SEC=30
# Batas event log per job (100–100000) dan jumlah job final yang disimpan per host (1–1000)
PXE_JOB_LOG_MAX_EVENTS=5000
PXE_JOB_HISTORY_PER_HOST=20
# local = host tanpa job boot dari disk; wait = host tanpa OS menunggu (loop terbatas)
PXE_UNKNOWN_HOST_ACTION=local
# Argumen kernel installer tambahan, mis. console=ttyS0,115200n8 console=tty0
PXE_KERNEL_EXTRA_ARGS=

# Header Host yang diterima untuk SEMUA request /api/** (mutasi SR-3-5; GET sejak M5, DEC-015),
# dipisah koma.
# Default: localhost,127.0.0.1,[::1],<PXE_SERVER_IP>,<host PXE_BASE_URL>
PXE_ALLOWED_HOSTS=
