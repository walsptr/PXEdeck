#!/usr/bin/env python3
"""pxe-nodes — kelola IP management per node (berdasarkan MAC) untuk PXE autoinstall.

  sudo pxe-nodes discover               # MAC yang terlihat di DHCP + status terdaftar/belum
  sudo pxe-nodes list                   # isi inventaris
  sudo pxe-nodes add <mac> <ip> [host]  # daftarkan/ubah node, lalu apply
  sudo pxe-nodes remove <mac>           # hapus node, lalu apply
  sudo pxe-nodes apply                  # generate ulang semua artefak dari inventaris

Artefak yang di-generate dari /srv/pxe/nodes.csv:
  /srv/pxe/dhcp-hosts                              reservasi DHCP (dnsmasq dhcp-hostsfile, reload via SIGHUP)
  /srv/pxe/http/autoinstall/nodes/<mac>/user-data  user-data per node (IP management statis)
  /srv/pxe/tftp/pxelinux.cfg/01-<mac-dash>         menu BIOS per node
UEFI/GRUB tidak butuh file per node: grub.cfg memakai ${net_default_mac}; MAC tak terdaftar
otomatis jatuh ke user-data default lewat rewrite Apache.
"""
import copy
import csv
import ipaddress
import os
import re
import shutil
import subprocess
import sys
import time

import yaml

# ---- Parameter jaringan management (sesuaikan bila subnet berubah) ----
MGMT_NET = ipaddress.ip_network("10.10.10.0/24")
GATEWAY = "10.10.10.1"
DNS = ["10.10.10.1"]
SEARCH = ["pxe.lab"]
DYN_RANGE = (ipaddress.ip_address("10.10.10.100"), ipaddress.ip_address("10.10.10.200"))
PXE_SERVER = "10.10.10.1"

INVENTORY = "/srv/pxe/nodes.csv"
DHCP_HOSTS = "/srv/pxe/dhcp-hosts"
LEASES = "/var/lib/misc/dnsmasq.leases"
LEASE_TIME = 12 * 3600
BASE_USERDATA = "/srv/pxe/http/autoinstall/user-data"
NODES_HTTP = "/srv/pxe/http/autoinstall/nodes"
PXELINUX_DIR = "/srv/pxe/tftp/pxelinux.cfg"
PXELINUX_DEFAULT = os.path.join(PXELINUX_DIR, "default")
GENERATED_MARK = "# generated by pxe-nodes"

MAC_RE = re.compile(r"^([0-9a-f]{2}:){5}[0-9a-f]{2}$")
HOST_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")


def die(msg):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def norm_mac(mac):
    mac = mac.strip().lower().replace("-", ":")
    if not MAC_RE.match(mac):
        die(f"MAC tidak valid: {mac}")
    return mac


def default_hostname(ip):
    return "node-" + str(ip).replace(".", "-")


def load_inventory():
    nodes = []
    if not os.path.exists(INVENTORY):
        return nodes
    with open(INVENTORY) as f:
        rows = [r for r in f if r.strip() and not r.lstrip().startswith("#")]
    for r in csv.DictReader(rows):
        mac = norm_mac(r["mac"])
        ip = (r.get("ip") or "").strip()
        host = (r.get("hostname") or "").strip().lower()
        nodes.append({"mac": mac, "ip": ip, "hostname": host})
    return nodes


def validate(nodes):
    seen_mac, seen_ip, seen_host = set(), set(), set()
    for n in nodes:
        try:
            ip = ipaddress.ip_address(n["ip"])
        except ValueError:
            die(f"{n['mac']}: IP tidak valid '{n['ip']}'")
        if ip not in MGMT_NET or ip in (MGMT_NET.network_address, MGMT_NET.broadcast_address):
            die(f"{n['mac']}: IP {ip} di luar {MGMT_NET}")
        if str(ip) == GATEWAY or str(ip) == PXE_SERVER:
            die(f"{n['mac']}: IP {ip} dipakai gateway/PXE server")
        if DYN_RANGE[0] <= ip <= DYN_RANGE[1]:
            die(f"{n['mac']}: IP {ip} berada di range DHCP dinamis {DYN_RANGE[0]}-{DYN_RANGE[1]}")
        n["hostname"] = n["hostname"] or default_hostname(ip)
        if not HOST_RE.match(n["hostname"]):
            die(f"{n['mac']}: hostname tidak valid '{n['hostname']}'")
        for key, seen in (("mac", seen_mac), ("ip", seen_ip), ("hostname", seen_host)):
            if n[key] in seen:
                die(f"{key} duplikat di inventaris: {n[key]}")
            seen.add(n[key])
    return nodes


def save_inventory(nodes):
    os.makedirs(os.path.dirname(INVENTORY), exist_ok=True)
    nodes = sorted(nodes, key=lambda n: ipaddress.ip_address(n["ip"]))
    tmp = INVENTORY + ".tmp"
    with open(tmp, "w", newline="") as f:
        f.write("# Inventaris node PXE: mac,ip,hostname (hostname opsional). Setelah edit: sudo pxe-nodes apply\n")
        w = csv.DictWriter(f, fieldnames=["mac", "ip", "hostname"])
        w.writeheader()
        w.writerows(nodes)
    os.replace(tmp, INVENTORY)


def write_if_changed(path, content, mode=0o644):
    old = open(path).read() if os.path.exists(path) else None
    if old != content:
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)


def node_userdata(base, n):
    ud = copy.deepcopy(base)
    ai = ud["autoinstall"]
    ai["identity"]["hostname"] = n["hostname"]
    # Hanya NIC management (cocok by MAC) yang dikonfigurasi; NIC lain dibiarkan
    # kosong untuk automation pre-req / kolla-ansible (mis. neutron_external_interface).
    ai["network"] = {
        "version": 2,
        "ethernets": {
            "mgmt": {
                "match": {"macaddress": n["mac"]},
                "dhcp4": False,
                "dhcp6": False,
                "addresses": [f"{n['ip']}/{MGMT_NET.prefixlen}"],
                "routes": [{"to": "default", "via": GATEWAY}],
                "nameservers": {"addresses": DNS, "search": SEARCH},
            }
        },
    }
    header = f"#cloud-config\n{GENERATED_MARK} — {n['mac']} {n['ip']} {n['hostname']} (jangan edit manual)\n"
    return header + yaml.safe_dump(ud, sort_keys=False, default_flow_style=False, width=1000)


def pxelinux_cfg(n, default_text):
    url = f"ds=nocloud-net;s=http://{PXE_SERVER}/pxe/autoinstall/"
    node_url = f"ds=nocloud-net;s=http://{PXE_SERVER}/pxe/autoinstall/nodes/{n['mac']}/"
    if url not in default_text:
        die(f"{PXELINUX_DEFAULT} tidak memuat '{url}'")
    text = default_text.replace(url, node_url)
    return f"{GENERATED_MARK} — {n['mac']} {n['ip']} {n['hostname']}\n" + text


def cmd_apply(nodes=None):
    nodes = validate(nodes if nodes is not None else load_inventory())
    with open(BASE_USERDATA) as f:
        base = yaml.safe_load(f)
    default_text = open(PXELINUX_DEFAULT).read()
    os.makedirs(NODES_HTTP, exist_ok=True)

    wanted_dirs, wanted_pxe = set(), set()
    for n in nodes:
        d = os.path.join(NODES_HTTP, n["mac"])
        os.makedirs(d, exist_ok=True)
        write_if_changed(os.path.join(d, "user-data"), node_userdata(base, n))
        write_if_changed(os.path.join(d, "meta-data"), f"instance-id: {n['hostname']}\nlocal-hostname: {n['hostname']}\n")
        write_if_changed(os.path.join(d, "vendor-data"), "")
        wanted_dirs.add(n["mac"])
        pxe_name = "01-" + n["mac"].replace(":", "-")
        write_if_changed(os.path.join(PXELINUX_DIR, pxe_name), pxelinux_cfg(n, default_text))
        wanted_pxe.add(pxe_name)

    # Bersihkan artefak node yang sudah dihapus dari inventaris
    for name in os.listdir(NODES_HTTP):
        if name not in wanted_dirs and MAC_RE.match(name):
            shutil.rmtree(os.path.join(NODES_HTTP, name))
    for name in os.listdir(PXELINUX_DIR):
        p = os.path.join(PXELINUX_DIR, name)
        if name.startswith("01-") and name not in wanted_pxe:
            if open(p).readline().startswith(GENERATED_MARK):
                os.remove(p)

    # id:* -> abaikan client-id (firmware PXE, installer dan OS memakai client-id berbeda)
    lines = [f"{GENERATED_MARK}\n"] + [f"{n['mac']},id:*,{n['ip']},{n['hostname']}\n" for n in nodes]
    write_if_changed(DHCP_HOSTS, "".join(lines))
    subprocess.run(["systemctl", "kill", "-s", "HUP", "dnsmasq"], check=True)
    print(f"Applied {len(nodes)} node(s); dnsmasq reloaded.")
    cmd_list(nodes)


def cmd_list(nodes=None):
    nodes = validate(nodes if nodes is not None else load_inventory())
    print(f"{'MAC':<19} {'IP MANAGEMENT':<15} HOSTNAME")
    for n in nodes:
        print(f"{n['mac']:<19} {n['ip']:<15} {n['hostname']}")
    if not nodes:
        print("(inventaris kosong)")


def cmd_discover():
    inv = {n["mac"]: n for n in load_inventory()}
    seen = {}
    if os.path.exists(LEASES):
        for line in open(LEASES):
            p = line.split()
            if len(p) < 4:
                continue
            expiry, mac, ip, host = int(p[0]), p[1].lower(), p[2], p[3]
            last = expiry - LEASE_TIME
            if mac not in seen or last > seen[mac]["last"]:
                seen[mac] = {"ip": ip, "host": "" if host == "*" else host, "last": last}
    print(f"{'MAC':<19} {'IP SAAT INI':<15} {'HOSTNAME DHCP':<16} {'TERAKHIR TERLIHAT':<19} STATUS")
    for mac, s in sorted(seen.items(), key=lambda kv: -kv[1]["last"]):
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(s["last"]))
        st = f"terdaftar -> {inv[mac]['ip']} ({inv[mac]['hostname'] or default_hostname(inv[mac]['ip'])})" if mac in inv else "BELUM TERDAFTAR"
        print(f"{mac:<19} {s['ip']:<15} {s['host'] or '-':<16} {when:<19} {st}")
    if not seen:
        print("(belum ada node yang meminta DHCP)")
    missing = [m for m in seen if m not in inv]
    if missing:
        print(f"\nDaftarkan dengan: sudo pxe-nodes add <mac> <ip> [hostname]   (IP di luar {DYN_RANGE[0]}-{DYN_RANGE[1]})")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if os.geteuid() != 0:
        die("jalankan dengan sudo")
    cmd, args = sys.argv[1], sys.argv[2:]
    if cmd == "discover":
        cmd_discover()
    elif cmd == "list":
        cmd_list()
    elif cmd == "apply":
        cmd_apply()
    elif cmd == "add" and len(args) in (2, 3):
        mac = norm_mac(args[0])
        nodes = [n for n in load_inventory() if n["mac"] != mac]
        nodes.append({"mac": mac, "ip": args[1], "hostname": (args[2] if len(args) == 3 else "").lower()})
        validate(copy.deepcopy(nodes))
        save_inventory(nodes)
        cmd_apply()
    elif cmd == "remove" and len(args) == 1:
        mac = norm_mac(args[0])
        nodes = load_inventory()
        if not any(n["mac"] == mac for n in nodes):
            die(f"{mac} tidak ada di inventaris")
        save_inventory([n for n in nodes if n["mac"] != mac])
        cmd_apply()
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
